{
  "name": "denis-presque-parfait-server",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "concurrently \"npm:watch:css\" \"npm:dev:server\"",
    "dev:server": "nodemon index.js",
    "watch:css": "sass --watch public/scss/main.scss:public/style.css",
    "build:css": "sass public/scss/main.scss:public/style.css --no-source-map",
    "test:video": "node -e \"require('./scripts/seedFakeGame').seedFakeCompletedGame(); require('./videoRecorder').recordResultsVideo({ port: process.env.PORT || 8080, durationMs: 9000 }).then((p) => console.log('OK ->', p))\""
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "connect-livereload": "^0.6.1",
    "livereload": "^0.10.3",
    "nodemon": "^3.1.7",
    "sass": "^1.79.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "express": "^4.19.2",
    "puppeteer-core": "^23.9.0",
    "puppeteer-screen-recorder": "^3.0.6",
    "ws": "^8.18.0"
  }
}
